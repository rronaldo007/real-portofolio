# Template for .env — copy to .env and fill in real values. Safe to commit.
#   cp .env.example .env
# docker compose auto-loads .env from the repo root.

# Django core
DJANGO_SECRET_KEY=change-me-generate-with-get_random_secret_key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Production only: the full https:// origin(s) of your deployed domain, comma-separated.
# Required for admin login / form POSTs once DEBUG=False on a real domain.
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.sevalla.app

# Auto-created admin. The superuser is created on first start only when a
# password is set here; an existing user with this username is left untouched.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=
